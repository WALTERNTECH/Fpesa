# ---------------------------------------------------------------- runtime
NODE_ENV=production
PORT=10000
# Public origin of the deployed site. Used to build Palpluss callback URLs.
PUBLIC_URL=https://fpesa.onrender.com

# ---------------------------------------------------------------- supabase
SUPABASE_URL=https://mrsxvdxaoogamhkdqejp.supabase.co
# Settings -> API Keys -> service_role (secret). NEVER ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- security
# Signs session tokens. Use a long random string (openssl rand -hex 48).
JWT_SECRET=
# Random string embedded in the Palpluss webhook path so only Palpluss can
# reach it: /api/webhooks/palpluss/<PALPLUSS_WEBHOOK_TOKEN>
PALPLUSS_WEBHOOK_TOKEN=

# ---------------------------------------------------------------- payments
PALPLUSS_API_KEY=
PALPLUSS_BASE_URL=https://api.palpluss.com/v1
# Optional: route collections through a specific Paybill/Till channel.
PALPLUSS_CHANNEL_ID=
# Set to "true" to run deposits/withdrawals against an in-process simulator
# instead of the live Palpluss API. Useful before your keys are provisioned.
PAYMENTS_MOCK=false

# ---------------------------------------------------------------- market data
# live      = poll a real XAU/USD source and interpolate ticks between updates
# simulated = fully synthetic price walk (no external calls)
PRICE_MODE=live
# Optional, improves feed quality/frequency when set (https://twelvedata.com)
TWELVEDATA_API_KEY=

# ---------------------------------------------------------------- trading
TRADE_PAYOUT_RATE=0.87
TRADE_MIN_STAKE=50
TRADE_MAX_STAKE=20000
DEMO_STARTING_BALANCE=10000
MIN_DEPOSIT=50
MIN_WITHDRAWAL=100

# ---------------------------------------------------------------- support
SUPPORT_TELEGRAM_URL=https://t.me/KRYPTONinv
