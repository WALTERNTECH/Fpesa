# ---------------------------------------------------------------- runtime
NODE_ENV=production
PORT=10000
# Public origin of the deployed site. Used to build the IntaSend callback URL.
PUBLIC_URL=https://fpesa.onrender.com

# ---------------------------------------------------------------- supabase
SUPABASE_URL=https://mrsxvdxaoogamhkdqejp.supabase.co
# Settings -> API Keys -> service_role (secret). NEVER ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- security
# Signs session cookies. Use a long random string (openssl rand -hex 48).
JWT_SECRET=
# Random string embedded in the IntaSend webhook path so only IntaSend can
# reach it: /api/webhooks/intasend/<INTASEND_WEBHOOK_TOKEN>
INTASEND_WEBHOOK_TOKEN=

# ---------------------------------------------------------------- payments
# IntaSend dashboard -> API Keys. Secret key only; never the publishable one.
INTASEND_SECRET_KEY=
# https://payment.intasend.com for live, https://sandbox.intasend.com for test
INTASEND_BASE_URL=https://payment.intasend.com
# IntaSend does not sign webhooks. It echoes this challenge string in every
# delivery instead, so it must match what is set beside the webhook URL in
# their dashboard. Without it, callbacks are rejected.
INTASEND_WEBHOOK_CHALLENGE=
# Credits deposits with no money taken — for exercising the wallet journey
# before live keys exist. The server refuses to boot with this enabled under
# NODE_ENV=production.
PAYMENTS_MOCK=false

# ---------------------------------------------------------------- market data
# live      = poll a real XAU/USD source and interpolate ticks between updates
# simulated = fully synthetic price walk (no external calls)
PRICE_MODE=live
# Optional, improves feed quality and gives a real previous close when set.
TWELVEDATA_API_KEY=

# ---------------------------------------------------------------- trading
# House margin lever. 0.87 pays 187 on a 100 stake, a ~6.5% edge per trade.
TRADE_PAYOUT_RATE=0.87
TRADE_MIN_STAKE=50
TRADE_MAX_STAKE=20000
DEMO_STARTING_BALANCE=10000
MIN_DEPOSIT=50
MIN_WITHDRAWAL=100

# ---------------------------------------------------------------- support
SUPPORT_TELEGRAM_URL=https://t.me/KRYPTONinv
