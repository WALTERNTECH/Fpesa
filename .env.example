# ---------------------------------------------------------------- runtime
NODE_ENV=production
PORT=10000
# Public origin of the deployed site. Used to build the IntaSend callback URL.
PUBLIC_URL=https://fpesa.onrender.com

# ---------------------------------------------------------------- supabase
SUPABASE_URL=https://mrsxvdxaoogamhkdqejp.supabase.co
# Settings -> API Keys -> service_role (secret). NEVER ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- security
# Signs session cookies. Use a long random string (openssl rand -hex 48).
JWT_SECRET=
# Random string embedded in the IntaSend webhook path so only IntaSend can
# reach it: /api/webhooks/intasend/<INTASEND_WEBHOOK_TOKEN>
INTASEND_WEBHOOK_TOKEN=

# ---------------------------------------------------------------- payments
# IntaSend dashboard -> API Keys. Secret key only; never the publishable one.
INTASEND_SECRET_KEY=
# https://payment.intasend.com for live, https://sandbox.intasend.com for test
INTASEND_BASE_URL=https://payment.intasend.com
# IntaSend does not sign webhooks. It echoes this challenge string in every
# delivery instead, so it must match what is set beside the webhook URL in
# their dashboard. Without it, callbacks are rejected.
INTASEND_WEBHOOK_CHALLENGE=
# Credits deposits with no money taken — for exercising the wallet journey
# before live keys exist. The server refuses to boot with this enabled under
# NODE_ENV=production.
PAYMENTS_MOCK=false

# ---------------------------------------------------------------- market data
# live      = poll a real XAU/USD source and interpolate ticks between updates
# simulated = fully synthetic price walk (no external calls)
PRICE_MODE=live
# Optional, improves feed quality and gives a real previous close when set.
TWELVEDATA_API_KEY=

# ---------------------------------------------------------------- trading
# Legacy binary payout rate. Unused by the multiplier model; kept for reference.
TRADE_PAYOUT_RATE=0.87
TRADE_MIN_STAKE=50
TRADE_MAX_STAKE=20000
DEMO_STARTING_BALANCE=10000
MIN_DEPOSIT=50
MIN_WITHDRAWAL=100

# ---------------------------------------------------------------- support
SUPPORT_TELEGRAM_URL=https://t.me/KRYPTONinv

# Position multiplier per duration, as "seconds:multiplier". The stake is
# margin: profit is stake x multiplier x fractional price move. Defaults are
# tuned to the current feed so a 1-sigma move over the duration is worth ~40%
# of stake. RETUNE THESE if you change the price feed.
TRADE_MULTIPLIERS=5:2000,10:1400,15:1150,30:800,60:575
# Profit ceiling as a multiple of stake. Bounds operator liability on a spike;
# the loss side is already bounded by the stake itself.
TRADE_MAX_PROFIT_MULTIPLE=3

# House edge per trade, as a fraction of stake — the same idea as a casino's
# RTP or a broker's spread, applied by marking the entry price against the
# trader by edge/multiplier. THIS is what sets long-run retention:
#   remaining = (1 - edge) ^ trades
# At 0.08 a deposit is down to ~19% after 20 trades, i.e. ~80% retained.
TRADE_HOUSE_EDGE=0.08
# Hard backstop. Once net shillings paid to traders reach this share of the
# day's deposits, the desk stops opening NEW real positions. It never alters an
# open position and never withholds a payout already won. 0 disables it.
DAILY_PAYOUT_CAP_RATIO=0.2
# Hysteresis on the cap. A closed desk only reopens once the ratio has fallen
# to cap x this, so it cannot flicker open and shut around the threshold.
DAILY_PAYOUT_REOPEN_FACTOR=0.8
# Deposit base the day must reach before the cap can engage. Below this the
# ratio is small-sample noise — one lucky trade on one small deposit would
# otherwise shut the desk, and a shut desk cannot attract the deposits that
# would bring the ratio back down.
DAILY_PAYOUT_MIN_DEPOSITS=20000
